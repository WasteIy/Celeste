; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Celeste"
run/main_scene="res://1/fase_1.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
Particles="*res://Scripts/Effects/particles.gd"
Displacement="*res://Scripts/Effects/displacement.gd"
ScreenWipe="*res://Scripts/Effects/screen_wipe.gd"
Freeze="*res://Scripts/Effects/freeze.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0627451, 0.078431375, 0.12156863, 1)
2d/snap/snap_2d_transforms_to_pixel=true
